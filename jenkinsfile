pipeline {
    agent {
        docker{
            image 'mcr.microsoft.com/playwright:v1.65.0-jammy'
            args '-u root --entrypoint='
        }
    }

    parameters {
       
        booleanParam(name: 'isTAG', defaultValue: true, description: 'lancer tout')
        choice(name: 'TAG', choices: ['@smoke', '@regression'], description: 'Tag des tests à lancer')

    }

    stages {
         stage('Check version nodejs') {
            steps {
                sh 'npm --version'
            }
        }
        stage('installation dependances') {
            steps {
                sh 'npm install '

            }
        }
        stage('Lancer le test') {
            steps {
               script{
                    if(params.isTAG == true){
                        sh"npx playwright test"
                    }else {
                        sh "npx playwright test --grep '${params.TAG}'"
                    }
                }
               
            }
        }
          
    }
} 
                    

