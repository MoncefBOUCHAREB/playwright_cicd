
 pipeline {
    agent {
        docker{
            image 'mcr.microsoft.com/playwright:v1.65.0-jammy'
            args '-u root --entrypoint='
        }
    }

    parameters {
        booleanParam(name: 'isBrowser', defaultValue: true, description: 'lancer tout')
        choice(name: 'Brows', choices: ['chromium', 'firefox', 'webjit'], description: 'choisir browser')
        booleanParam(name: 'isTAG', defaultValue: true, description: 'lancer tout')
        choice(name: 'TAG', choices: [ '@smoke', '@regression'], description: 'Tag des tests à lancer')

    }

    stages {
         stage('Check version nodejs') {
            steps {
                sh 'npm --version'
            }
        }
        stage('installation dependances') {
            steps {
                sh 'npm install '

            }
        }
        stage('Lancer le test') {
            steps {
               script{
                    if(params.isTAG == true && params.isBrowser == true){
                        sh"npx playwright test --project=${params.Brows} --grep='${params.TAG}"
                    }
                    else {
                        if(params.isTAG ==true){
                            sh "npx playwright test --grep '${params.TAG}'"
                        }
                        else{
                            sh "npx playwright test --project=${params.Brows}"
                        }
                    }
               
                }
               
               
            }
        }
          
    }
} 
                    

